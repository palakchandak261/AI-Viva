# App
APP_NAME="AI Viva Examiner"
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gemini AI — FREE (get key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Groq Whisper — FREE voice transcription (get key at https://console.groq.com)
GROQ_API_KEY=your-groq-api-key-here

# Database — SQLite (dev, zero-config)
DATABASE_URL=sqlite+aiosqlite:///./viva_dev.db

# Database — PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/viva_db

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# CORS
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
